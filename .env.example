# ── OWNER ─────────────────────────────────────────────────────────────────────
EDDIE_OWNER_NAME=       # Your name (used in briefs and greetings)
EDDIE_HOME=             # Override home directory (optional, default: auto-detected)
BRAIN_VAULT_PATH=       # Path to your Brain Vault (default: ~/brain-vault)
PERSONAL_GIT_REPO=      # Your private EDDIE fork repo URL (optional)

# ── TELEGRAM ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=     # From @BotFather
OWNER_TELEGRAM_ID=      # Your Telegram user ID (from @userinfobot)

# ── CLAUDE ────────────────────────────────────────────────────────────────────
CLAUDE_PATH=            # Path to claude CLI binary (default: claude)
# EDDIE_CLAUDE_HOME=    # Set if using a dedicated Claude subscription for EDDIE

# ── SUPABASE (semantic memory — required for memory features) ─────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_PAT=         # Only needed for migration auto-apply

# ── GOOGLE (embeddings + OAuth) ───────────────────────────────────────────────
GOOGLE_API_KEY=         # Free tier — used for gemini-embedding-001
# GOOGLE_CLIENT_ID=     # OAuth client (for Google Workspace integration)
# GOOGLE_CLIENT_SECRET=
# GOOGLE_SERVICE_ACCOUNT_PATH=   # Path to service account JSON key
# GOOGLE_OAUTH_TOKENS_PATH=      # Path to tokens.json (e.g. ~/.claude/google-hub/tokens.json)
# GOOGLE_OAUTH_CREDENTIALS_PATH= # Path to credentials.json

# ── DASHBOARD ─────────────────────────────────────────────────────────────────
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000
# DASHBOARD_TOKEN=      # Optional auth token
# DASHBOARD_HOST=       # Default: 127.0.0.1

# ── JOBS ──────────────────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=    # 2 (Pro) | 4 (Max 5x) | 8 (Max 20x)
JOBS_DATA_DIR=          # Default: ./data
# BRAIN_VAULT_JOBS_DIR= # Default: ~/brain-vault/90 - Agent Memory/Jobs
JOBS_DEFAULT_TIMEOUT_MS=# Default: 7200000 (2 hours)

# ── COMMS — Slack ─────────────────────────────────────────────────────────────
# COMMS_ENABLED=true
# COMMS_SLACK_BOT_TOKEN=
# COMMS_SLACK_WATCH_CHANNELS=    # comma-separated channel IDs
# SLACK_OWNER_USER_ID=           # Your Slack user ID (for @mention detection)

# ── COMMS — iMessage (Mac relay required) ─────────────────────────────────────
# COMMS_IMESSAGE_RELAY_URL=      # http://mac-tailscale-ip:3456
# COMMS_IMESSAGE_RELAY_KEY=

# ── COMMS — Email ─────────────────────────────────────────────────────────────
# COMMS_EMAIL_ACCOUNTS=          # comma-separated email addresses

# ── PROACTIVE SCHEDULES ───────────────────────────────────────────────────────
TIMEZONE=America/Chicago
PROACTIVE_QUIET_START=22         # Quiet hours start (default: 10 PM)
PROACTIVE_QUIET_END=8            # Quiet hours end (default: 8 AM)
# MORNING_BRIEF_ENABLED=false
# MORNING_BRIEF_TIME=08:00
# DREAM_ENABLED=false
# DREAM_TIME=02:00
# NIGHTLY_ORCHESTRATE_ENABLED=false
# NIGHTLY_ORCHESTRATE_TIME=02:30
# HEARTBEAT_ENABLED=false

# ── SECURITY ──────────────────────────────────────────────────────────────────
# SECURITY_COUNCIL_ENABLED=false
# INTEGRITY_CHECK_ENABLED=false
# OUTPUT_SCAN_ENABLED=false
# TRUST_CLASSIFICATION_ENABLED=false
# MCP_AUDIT_LOG_ENABLED=false
# ANOMALY_DETECT_ENABLED=false

# ── FEATURE FLAGS ─────────────────────────────────────────────────────────────
MEMORY_MONITOR_ENABLED=true
COST_TRACKING_ENABLED=true
INTENT_DETECTION_ENABLED=true
# COMMS_NOTIFY_ENABLED=true
# MIGRATIONS_AUTO_APPLY=false
# OPTIMIZER_ENABLED=false
# OPTIMIZER_TIME=03:00

# ── HEIMDALL (community piece management) ─────────────────────────────────────
# HEIMDALL_TRUSTED_AUTHORS=      # comma-separated GitHub handles, empty = open

# ── MODEL ROUTING ─────────────────────────────────────────────────────────────
RELAY_MODEL=sonnet
# HEARTBEAT_MODEL=haiku
# LOG_LEVEL=info
