# Owner configuration
EDDIE_OWNER_NAME=       # Your name (used in greetings and briefs)
EDDIE_HOME=             # Override home directory detection (optional, default: auto-detected)
BRAIN_VAULT_PATH=       # Path to your Brain Vault (default: ~/brain-vault)
PERSONAL_GIT_REPO=      # Your private Eddie fork repo URL (optional)

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your Telegram user ID (for owner-only access)
OWNER_TELEGRAM_ID=
# ElevenLabs API key for voice features
ELEVENLABS_API_KEY=
# Supabase (semantic memory)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PAT=
# OpenAI (embeddings)
OPENAI_API_KEY=
# Path to claude CLI binary (default: claude)
CLAUDE_PATH=
# Directory for session persistence (default: ./sessions)
SESSION_DIR=
# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=
# Twilio (voice calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_PORT=
TWILIO_WEBHOOK_URL=
OWNER_PHONE=
# Dashboard
DASHBOARD_PORT=
DASHBOARD_ENABLED=
DASHBOARD_HOST=
DREAM_ENABLED=
DREAM_TIME=
MORNING_BRIEF_ENABLED=
GOAL_TASK_ENABLED=
# Heartbeat quiet hours
PROACTIVE_QUIET_START=
PROACTIVE_QUIET_END=
# Heartbeat engine
HEARTBEAT_ENABLED=
HEARTBEAT_INTERVAL_MS=
TIMEZONE=
# Model routing (defaults: sonnet for relay, haiku for heartbeat)
RELAY_MODEL=
HEARTBEAT_MODEL=
# Direct Anthropic API key — enables Voice V2 (~3-5s latency vs ~10-15s CLI spawn)
# ANTHROPIC_API_KEY=
# Background job dispatcher
JOBS_DATA_DIR=
BRAIN_VAULT_JOBS_DIR=
KIMI_PATH=
TMUX_PATH=
JOB_POLL_INTERVAL_MS=
# Unified Communications Layer
COMMS_ENABLED=
COMMS_NOTIFY_ENABLED=
# Google OAuth — reuses existing google-hub credentials (gmail.readonly, calendar.readonly, drive.readonly)
GOOGLE_OAUTH_TOKENS_PATH=
GOOGLE_OAUTH_CREDENTIALS_PATH=
COMMS_EMAIL_ACCOUNTS=
# iMessage relay — deploy imessage/relay-server.ts on Mac first, then set:
# COMMS_IMESSAGE_RELAY_URL=
# COMMS_IMESSAGE_RELAY_KEY=
# Slack — create app at api.slack.com, get bot token, then set:
# COMMS_SLACK_BOT_TOKEN=
# COMMS_SLACK_WATCH_CHANNELS=
# iCloud Calendar — generate app-specific password at appleid.apple.com:
# ICLOUD_EMAIL=
# ICLOUD_APP_PASSWORD=
YOUTUBE_API_KEY=
GOOGLE_API_KEY=
