kprobe:oom_kill_process {
  printf("{\"type\":\"oom_kill\",\"pid\":%d,\"comm\":\"%s\",\"ts\":%llu}\n",
    pid, comm, nsecs);
}

tracepoint:oom:oom_score_adj_update {
  printf("{\"type\":\"oom_adj\",\"pid\":%d,\"comm\":\"%s\",\"score\":%d,\"ts\":%llu}\n",
    args->pid, args->comm, args->oom_score_adj, nsecs);
}

interval:s:30 {
  printf("{\"type\":\"mem_tick\",\"ts\":%llu}\n", nsecs);
}
